# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env a control de versiones.

# URL del endpoint de Power Automate para acceso a Dataverse
DATAVERSE_URL=https://<environment>.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/<workflow-id>/triggers/manual/paths/invoke?api-version=1&sp=...

# Timeout en segundos para las solicitudes HTTP (por defecto: 60)
TIMEOUT=60

# Conexión a SQL Server BDNS
BDNS_SQL_SERVER=<servidor>.database.windows.net
BDNS_SQL_DATABASE=<nombre_base_de_datos>
BDNS_SQL_USERNAME=<usuario>
BDNS_SQL_PASSWORD=<contraseña>
BDNS_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Conexión a SQL Server GRANTS
GRANTS_SQL_SERVER=<servidor>.database.windows.net
GRANTS_SQL_DATABASE=<nombre_base_de_datos>
GRANTS_SQL_USERNAME=<usuario>
GRANTS_SQL_PASSWORD=<contraseña>
GRANTS_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Conexión a LLM (FI Group OpenAI)
LLM_API_KEY=<LLM_API_KEY>

# ── Servidor MCP / API ────────────────────────────────────────────────────────
SERVER_NAME=CRM_MCP
SERVER_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http

# Autenticacion del endpoint MCP: 'none' o 'bearer'
MCP_AUTH_MODE=none
MCP_BEARER_TOKEN=

# Ruta al Excel generado por el proceso semanal (dejar vacio para usar output/citas.xlsx)
EXCEL_PATH=