# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env a control de versiones.

# URL del endpoint de Power Automate para acceso a Dataverse
DATAVERSE_URL=https://<environment>.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/<workflow-id>/triggers/manual/paths/invoke?api-version=1&sp=...

# Timeout en segundos para las solicitudes HTTP (por defecto: 60)
TIMEOUT=60

# ── SQL endpoint de Fabric (service principal) ─────────────────
# Nombres exactos que lee scripts/clients/bdns_client.py. Requiere ODBC Driver 18 >= 18.1.
# Endpoint completo desde Warehouse > Settings > SQL connection string.
FABRIC_SQL_ENDPOINT=xxxxxxxx.datawarehouse.fabric.microsoft.com
# Nombre del warehouse o lakehouse al que se conecta.
FABRIC_DATABASE=LH_Operations_30_Gold
# Directorio (tenant) donde esta registrada la aplicacion.
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID de la aplicacion registrada.
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Secreto (credential tipo password) asignado a la aplicacion registrada.
FABRIC_CLIENT_SECRET=cambia-este-secreto

# Conexión a SQL Server GRANTS
# Nombres exactos que lee scripts/clients/grants_client.py.
GRANTS_SERVER=<servidor>.database.windows.net
GRANTS_DATABASE=Apps_Grants
GRANTS_USERNAME=<usuario>
GRANTS_PASSWORD=<contraseña>

# Opcional. Por defecto: ODBC Driver 18 for SQL Server
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Conexión a LLM (FI Group OpenAI)
LLM_API_KEY=<LLM_API_KEY>

# ── Servidor MCP / API ────────────────────────────────────────────────────────
SERVER_NAME=CRM_MCP
SERVER_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp
MCP_TRANSPORT=streamable-http

# Autenticacion del endpoint MCP: 'none' o 'bearer'
MCP_AUTH_MODE=none
MCP_BEARER_TOKEN=

# Ruta al Excel generado por el proceso semanal (dejar vacio para usar output/citas.xlsx)
EXCEL_PATH=